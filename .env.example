# Copy to .env for local development. `nuxt dev` and `wrangler dev` both read it.

# --- Build time: baked into the prerendered HTML ---
NUXT_SITE_URL=http://localhost:3000
# Only "production" makes the site indexable by search engines.
NUXT_SITE_ENV=staging
# Cloudflare's always-pass test key.
NUXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# --- Runtime: Worker secrets in production ---
NUXT_TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Empty skips the hostname check (test keys don't report your hostname).
NUXT_TURNSTILE_HOSTNAME=
# Keep the leading "+" so the phone isn't parsed as a number.
NUXT_CONTACT_PHONE=+39 000 000 0000
NUXT_CONTACT_EMAIL=you@example.com
NUXT_RESEND_API_KEY=
NUXT_RESEND_TO=
# true = log contact emails instead of sending them.
NUXT_RESEND_DRY_RUN=true
